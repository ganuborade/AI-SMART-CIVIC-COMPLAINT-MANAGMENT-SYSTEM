# ==========================================================
# AI SMART CIVIC COMPLAINT MANAGEMENT SYSTEM - ENVIRONMENT CONFIG TEMPLATE
# Copy this file as '.env' and enter your local configuration
# ==========================================================

# MySQL 8+ Database Configuration (Connection Pooling Enabled)
DB_URL=jdbc:mysql://localhost:3306/civic_db?
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration (HS256 requires minimum 256-bit / 32-char key)
JWT_SECRET=civic-smart-ai-complaint-system
JWT_EXPIRATION_MS=86400000

# Registration Security Passkeys for Municipal Staff and Administrators
ADMIN_REGISTRATION_KEY=ADN@123
EMPLOYEE_REGISTRATION_KEY=STF@123

# Google Gemini API Key for Live Multimodal Vision & Reasoning
# (Optional: Leave empty to use the built-in Intelligent Local AI Engine)
GEMINI_API_KEY=

# Server Configuration
SERVER_PORT=8252

# File Upload Directory
FILE_UPLOAD_DIR=./uploads
